rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can create and read only their own profile document.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'firstName', 'lastName', 'birthdate', 'createdAt'])
        && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 50
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 50;
      allow update, delete: if false;
    }

    // An admin is any user who has a document at admins/{uid}. These documents can only be created
    // by hand in the Firebase console, so nobody can make themselves an admin from the app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Items are public to read; only admins can add, edit or delete them.
    match /items/{itemId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'category', 'price', 'discountedPrice', 'fabric', 'colour', 'description', 'sizes', 'stitching', 'pieces', 'note', 'cover', 'photoCount', 'createdBy', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['1PC', '2PC', '3PC', 'Casual', 'Semi Formal', 'Formal']
        && (!('stitching' in request.resource.data) || request.resource.data.stitching in ['Stitched', 'Unstitched', 'none'])
        && (!('sizes' in request.resource.data) || (request.resource.data.sizes is list && request.resource.data.sizes.size() <= 12))
        && (!('pieces' in request.resource.data) || (request.resource.data.pieces is list && request.resource.data.pieces.size() <= 8))
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200))
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.cover is string && request.resource.data.cover.size() <= 260000
        && request.resource.data.photoCount is int && request.resource.data.photoCount >= 1 && request.resource.data.photoCount <= 4
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Full-size photos (compressed data URLs) live beside the item so item lists stay small.
      match /photos/{photoId} {
        allow read: if true;
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['index', 'data'])
          && request.resource.data.index is int
          && request.resource.data.data is string && request.resource.data.data.size() <= 800000;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Orders: anyone can place an order (cash on delivery only), signed in or as a guest.
    // - One order can be opened by anyone who has its id (the tracking code, 20 random characters), so
    //   guests can follow their order. Listing orders is limited to the owner and admins.
    // - Admins can update an order's status. Nobody can delete an order.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.resource.data.keys().hasOnly(['userId', 'contact', 'shipping', 'notes', 'paymentMethod', 'items', 'subtotal', 'status', 'statusTimes', 'createdAt'])
        && (request.resource.data.userId == null || (request.auth != null && request.resource.data.userId == request.auth.uid))
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.status == 'pending'
        && request.resource.data.contact.keys().hasOnly(['name', 'email', 'phone'])
        && request.resource.data.contact.name is string && request.resource.data.contact.name.size() <= 50
        && request.resource.data.contact.email is string && request.resource.data.contact.email.size() <= 100
        && request.resource.data.contact.phone is string && request.resource.data.contact.phone.size() <= 20
        && request.resource.data.shipping.keys().hasOnly(['address', 'city', 'postalCode'])
        && request.resource.data.shipping.address is string && request.resource.data.shipping.address.size() <= 200
        && request.resource.data.shipping.city is string && request.resource.data.shipping.city.size() <= 60
        && request.resource.data.shipping.postalCode is string && request.resource.data.shipping.postalCode.size() <= 10
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 300
        && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
        && request.resource.data.statusTimes.keys().hasOnly(['pending'])
        && request.resource.data.statusTimes.pending == request.time
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
